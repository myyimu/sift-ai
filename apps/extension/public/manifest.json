{
  "manifest_version": 3,
  "name": "Sift AI Demo Observer",
  "short_name": "Sift",
  "version": "0.1.0",
  "description": "Sift AI P0 demo — read-only browser observer. Fixed demo key; Native Host only allows this extension ID.",
  "key": "",
  "minimum_chrome_version": "109",
  "action": {
    "default_title": "Sift：授权观察当前页面"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "commands": {
    "sift-grant-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "授权观察当前页面（与点击工具栏图标等价）"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
